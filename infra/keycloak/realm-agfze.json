  "clientScopeMappings": {},
  "identityProviders": [
    {
      "alias": "entra-id",
      "displayName": "Microsoft Entra ID",
      "providerId": "oidc",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "useJwksUrl": "true",
        "metadataDescriptorUrl": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/v2.0/.well-known/openid-configuration",
        "issuer": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/v2.0",
        "authorizationUrl": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/oauth2/v2.0/authorize",
        "tokenUrl": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/oauth2/v2.0/token",
        "userInfoUrl": "https://graph.microsoft.com/oidc/userinfo",
        "jwksUrl": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/discovery/v2.0/keys",
        "logoutUrl": "https://login.microsoftonline.com/REPLACE-ME-TENANT-ID/oauth2/v2.0/logout",
        "clientId": "REPLACE-ME-BROKER-APP-CLIENT-ID",
        "clientAuthMethod": "client_secret_post",
        "clientSecret": "REPLACE-ME-BROKER-APP-CLIENT-SECRET",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "validateSignature": "true",
        "backchannelSupported": "false",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ],
