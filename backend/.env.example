# Copy to backend/.env (`make setup` does this for you) and adjust for your machine.
# Every variable below maps to a field on app.core.config.Settings; anything left out falls back
# to the default declared there. Values shown are the local development stack from docker-compose.

# --- Application ------------------------------------------------------------------------------
# Selects the Settings subclass: development | testing | production.
ENV=development
# Product name reported by /health and the OpenAPI document.
PROJECT_NAME=AGFZE Command Centre
# Mount point for the versioned API. Changing it changes every client URL.
API_V1_PREFIX=/api/v1
# Root log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------------------------
# Async SQLAlchemy DSN. Inside docker-compose the host is `postgres`, not `localhost`.
DATABASE_URL=postgresql+asyncpg://agfze:agfze@localhost:5432/agfze
# Connections held open per worker process.
DATABASE_POOL_SIZE=10
# Extra connections allowed above the pool size during a burst.
DATABASE_MAX_OVERFLOW=20
# Echo every statement to the log. Keep false outside of a debugging session.
DATABASE_ECHO=false
# Used only by the test suite; `make test-backend` points this at the agfze_test database.
# Unset, the suite falls back to a disposable SQLite file under ./var.
TEST_DATABASE_URL=postgresql+asyncpg://agfze:agfze@localhost:5432/agfze_test

# --- Identity (Keycloak / Microsoft Entra ID) ---------------------------------------------------
# Issuer exactly as it appears in the `iss` claim. Keycloak signs with the hostname it was
# addressed by, so this stays the browser-facing form even when the API runs in a container.
KEYCLOAK_ISSUER=http://localhost:8080/realms/agfze
# JWKS endpoint the API fetches signing keys from; inside compose use the internal host.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/agfze/protocol/openid-connect/certs
# Expected audience. Keycloak reports the client id in `azp` when it is absent from `aud`.
KEYCLOAK_AUDIENCE=agfze-command-centre
# Comma-separated list of accepted signing algorithms.
JWT_ALGORITHMS=RS256
# Clock skew tolerated on exp/nbf, in seconds.
JWT_LEEWAY_SECONDS=30

# --- Keycloak Admin REST API (Step 9) ------------------------------------------------------------
# A THIRD machine credential, and deliberately a third one. It is not the OIDC login client above -
# that one is what staff sign in through and holds no administrative grant at all - and it is not
# the Azure AD app registration further down, which reads one mailbox and writes one workbook.
# This one is a service account on its own confidential client, used by exactly one code path: the
# rare manual role override on /admin/users. Keeping the three separate means a leak of any one of
# them costs the blast radius of that one capability and nothing more.
#
# In Keycloak: create a confidential client with Standard Flow OFF and Service Accounts Roles ON,
# then grant its service account the `manage-users` client role of the built-in `realm-management`
# client. Nothing else - not `realm-admin`, not `manage-realm`. The local dev realm
# (infra/keycloak/realm-agfze.json) already ships this client, so `make setup` gives you a working
# one to test against.
#
# Base URL of the Keycloak server itself, WITHOUT the /realms/... suffix. Inside compose the API
# reaches Keycloak on the internal hostname, exactly as it does for JWKS.
KEYCLOAK_SERVER_URL=http://keycloak:8080
# The realm the platform's accounts live in.
KEYCLOAK_REALM=agfze
KEYCLOAK_ADMIN_CLIENT_ID=agfze-admin-api
# Never logged, never returned by any endpoint, never sent to the frontend. Inject it from a
# secret store in every deployed environment; the value below is the local dev realm's only.
KEYCLOAK_ADMIN_CLIENT_SECRET=agfze-local-admin-api-secret
KEYCLOAK_ADMIN_TIMEOUT_SECONDS=15

# --- Graph projection -----------------------------------------------------------------------------
# A derived, rebuildable read model for traceability questions. Off and unconfigured by default -
# it is a real infrastructure commitment, and nothing on the platform depends on it: every value it
# holds is read from PostgreSQL first, and the projection can be rebuilt from scratch at any time.
GRAPH_SYNC_ENABLED=false
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_SYNC_INTERVAL_SECONDS=300
GRAPH_SYNC_BATCH_SIZE=500

# --- Document retention ---------------------------------------------------------------------------
# Off, with no period, in dry run. The BRD asks for a retention policy and leaves the period for
# AGFZE to confirm, so nothing here ships with a default: a wrong retention period ages out trade
# documents nobody agreed to lose, and unlike a wrong threshold that is not reversible.
DOCUMENT_RETENTION_ENABLED=false
# 0 means unset, not "immediately". The sweep refuses to run on it whatever the flag above says.
DOCUMENT_RETENTION_DAYS=0
# Even fully configured, the job only reports what it would flag until this is false - and what it
# does then is write an audit row for a person to review. It never deletes anything.
DOCUMENT_RETENTION_DRY_RUN=true

# --- Document storage ---------------------------------------------------------------------------
# Storage driver: `local` or `gcs`. Local writes to a directory and signs download URLs back to
# this application; gcs writes to a bucket through the Cloud Storage client and issues the bucket's
# own pre-signed URLs, so document bytes never pass through the API process.
STORAGE_BACKEND=local
# Root directory for the local driver, relative to the backend working directory.
STORAGE_LOCAL_ROOT=./var/storage
# The bucket the `gcs` driver reads and writes. Required whenever the driver is not `local`;
# production refuses to start without it. Credentials come from the runtime's own workload
# identity - there is no key to put here.
STORAGE_BUCKET=
# HMAC key for signed download URLs. Replace before any shared or production deployment.
STORAGE_SIGNED_URL_SECRET=replace-with-a-random-32-byte-secret
# Lifetime of a signed URL, in seconds.
STORAGE_SIGNED_URL_TTL_SECONDS=900
# Prefix that signed URLs are built on.
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/internal/files

# --- Rate limiting ------------------------------------------------------------------------------
# Off locally so development traffic is never throttled; forced on in production settings, which
# also refuse to start if any limit below is blank.
RATE_LIMIT_ENABLED=false
# Default budget applied to every non-health route.
RATE_LIMIT_DEFAULT=120/minute
# Where the counters live. In-process by default, which counts per instance: point this at a
# shared store ("redis://host:6379/0") wherever more than one instance serves. Production refuses
# to start on an in-process store unless the next setting says that is deliberate; the production
# Terraform provisions a Memorystore instance and wires this for you.
RATE_LIMIT_STORAGE_URI=memory://
# Accepts per-instance counting in production. Only ever true on a deliberately single-instance
# deployment: with several instances, every limit is multiplied by the instance count.
RATE_LIMIT_ALLOW_IN_PROCESS=false
# Whether the left-most X-Forwarded-For entry is trusted as the client address. Only true behind a
# proxy this deployment controls; on a directly-reachable process the header is forgeable and
# honouring it would defeat every limit below.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# The four categories most exposed to abuse or accidental overload, each with a real value rather
# than a boolean. Applied before the default ceiling above and enforced independently of it.
# Authentication-adjacent: the profile read every sign-in makes, and the preference write beside it.
RATE_LIMIT_AUTH=30/minute
# File upload.
RATE_LIMIT_UPLOAD=20/minute
# Every endpoint that can reach the model, including opening an approval (its summary is generated
# on first view, so a read costs a model call).
RATE_LIMIT_AI=15/minute
# Bulk approval.
RATE_LIMIT_BULK_APPROVAL=5/minute
# The unauthenticated Graph webhook, which is secret-checked rather than token-checked.
RATE_LIMIT_WEBHOOK=120/minute

# --- Transport security ---------------------------------------------------------------------------
# HSTS lifetime, in seconds. Emitted only over HTTPS and only in production, so a local plain-HTTP
# stack is never pinned to a scheme it does not serve. Two years is the preload-list minimum.
HSTS_MAX_AGE_SECONDS=63072000

# --- HTTP ---------------------------------------------------------------------------------------
# Comma-separated exact origins allowed to call the API with credentials. "*" is rejected in
# production because credentialed CORS requires an exact origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Error tracking -----------------------------------------------------------------------------
# Leave empty to disable Sentry entirely; no network call is made when it is unset.
SENTRY_DSN=
# Fraction of transactions sampled for tracing, 0.0 to 1.0.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Microsoft Graph mailbox intake (Step 2) -----------------------------------------------------
# A dedicated Azure AD app registration used as a machine identity through the OAuth2
# client-credentials flow. It has no interactive login and is entirely separate from the
# Keycloak/Entra broker above that staff sign in through. Grant it Mail.Read narrowed to the one
# approved shared mailbox (application access policy). From Step 7 it also carries the Excel write
# scope the tracker synchronisation needs - Files.ReadWrite.Selected, or Sites.Selected on the site
# holding the workbooks, narrowed to the tracker files themselves and never tenant-wide.
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Inject from a secret store in every deployed environment. Never commit a real value.
AZURE_AD_CLIENT_SECRET=replace-with-the-app-registration-client-secret
# The approved shared mailbox that is polled and subscribed to.
GRAPH_MAILBOX_ADDRESS=trade.docs@example.com
# Graph and login endpoints. Change only for a sovereign cloud (US Gov, China, Germany).
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_LOGIN_BASE_URL=https://login.microsoftonline.com
GRAPH_SCOPE=https://graph.microsoft.com/.default
GRAPH_TIMEOUT_SECONDS=30
# The delta-query fallback poll. It runs even when the webhook is on, so a missed delivery costs
# latency rather than the message.
GRAPH_POLL_ENABLED=true
GRAPH_POLL_INTERVAL_SECONDS=120
# Change notifications need a URL Microsoft can reach from the public internet, so they stay off
# on a developer machine unless you tunnel one in (see README).
GRAPH_WEBHOOK_ENABLED=false
GRAPH_WEBHOOK_NOTIFICATION_URL=https://your-public-host/api/v1/graph/notifications
# Echoed by Graph on every notification and compared in constant time. Generate a random value:
#   openssl rand -hex 32
GRAPH_WEBHOOK_CLIENT_STATE=
# Subscription lifetime requested, in minutes. Graph caps mail subscriptions near 4230 (~3 days);
# the worker renews well before expiry.
GRAPH_SUBSCRIPTION_TTL_MINUTES=4230
GRAPH_MAX_ATTACHMENTS_PER_MESSAGE=25

# --- AI classification and extraction (Step 2) ---------------------------------------------------
# Provider the AI service resolves. `gemini_flash` is the implemented provider; `vertex_ai` is a
# declared extension point and fails loudly rather than pretending to work.
AI_PROVIDER=gemini_flash
# Google AI Studio API key. Never logged, never returned by any endpoint, never in frontend code.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=8192
# At or above this score a classification or extraction stands on its own. Below it the item is
# flagged for human review, and correcting such a field requires a recorded reason.
CONFIDENCE_THRESHOLD_DEFAULT=0.75

# --- Document intake limits (Step 2) -------------------------------------------------------------
# Hard per-file ceiling, enforced while the body is still streaming. 25 MB.
MAX_UPLOAD_BYTES=26214400
UPLOAD_CHUNK_BYTES=1048576
# Resolution page images are rasterised at, and reused by the review viewer.
PAGE_RASTER_DPI=150
# Pages sent to the multimodal model per call, and the ceiling on pages read per document.
EXTRACTION_PAGE_WINDOW=2
EXTRACTION_MAX_PAGES=40

# --- Shipment tracking (Step 6) ------------------------------------------------------------------
# None of these is required. The whole block can be left at its defaults, and on a deployment that
# has not negotiated carrier tracking access - which is every deployment today - it should be.
#
# The sweep runs whether or not any carrier adapter exists, because it does two jobs and only the
# first needs one: it attempts a pull, and it notices the shipments nobody has established anything
# about for longer than the configured threshold and opens a real, owned exception against each.
# The second half is the whole value of the job for a desk tracking its cargo by hand.
SHIPMENT_TRACKING_POLL_ENABLED=true
# Six hours, in seconds. Roughly how often a carrier's own tracking page moves.
SHIPMENT_TRACKING_INTERVAL_SECONDS=21600
# How many shipments one sweep attempts, so a large backlog cannot monopolise the worker.
SHIPMENT_TRACKING_BATCH_SIZE=100
# A convenience flag, not a promise. No carrier's tracking API is specified for this platform, so
# no concrete adapter ships and every shipment is tracked by hand. Turning this on does nothing
# until an adapter is actually registered; it exists so a deployment can say "we have one" in one
# place rather than in several.
SHIPMENT_CARRIER_ADAPTERS_ENABLED=false
#
# The staleness threshold (48 hours), the repeated-failure limit and the implausible-ETA margin are
# deliberately NOT here. They are business thresholds, so they live in `rule_configurations` under
# the GOV-03 namespace beside every other configurable value, editable with a stated reason and
# without a redeploy.

# --- Downstream integration: tracker, SAP, DMS (Step 7) ------------------------------------------
# Every variable in this block is optional, and a fresh local environment with none of them set
# works correctly: each integration job reaches `awaiting_manual_action` - an honest state meaning
# "the platform has prepared everything it can and a person finishes the posting" - rather than
# erroring, hanging, or reporting a success that never happened.
#
# The tracker. The Excel client behind these is real, complete and row-level (it patches a row
# through Microsoft Graph and never opens or re-saves the workbook), and it uses the SAME app
# registration as the mailbox above. Grant that registration Files.ReadWrite.Selected - or
# Sites.Selected on the site holding the tracker - narrowed to the specific tracker workbooks.
# A tenant-wide Files.ReadWrite.All would let this process rewrite every document in the
# organisation to update one spreadsheet row, and nothing here needs that.
#
# These five values are PLACEHOLDERS pending AGFZE's confirmation of which workbook, sheet, table
# and columns are the live tracker. Left blank, the tracker job prepares the row for a person
# instead of writing into a workbook nobody named.
TRACKER_DRIVE_ID=
TRACKER_WORKBOOK_ITEM_ID=
TRACKER_WORKSHEET_NAME=Tracker
TRACKER_TABLE_NAME=
# The column whose value identifies a batch's row. Rows are matched on it, and appended only when
# it matches nothing.
TRACKER_KEY_COLUMN=Batch Number
# {platform field: workbook column header}, as JSON. The available field names are the keys
# `app.services.integration.payloads.tracker_fields` produces - batch_number, counterparty,
# contract_number, commodity_code, quantity_mt, currency, rate, amount, invoice_status,
# port_of_loading, port_of_discharge, territory, hedge_date, status and the rest.
# Example, once the real tracker is confirmed:
#   TRACKER_COLUMN_MAP={"batch_number":"Batch Number","counterparty":"Supplier"}
TRACKER_COLUMN_MAP=

# SAP. No confirmed API, BAPI or OData endpoint for AGFZE's SAP exists in this platform's
# governing material, so none is guessed at in code: leaving the base URL blank is the normal,
# expected state and the trigger for the manual-preparation path, not an error. Set it and the
# adapter posts the prepared trade contract and deal price record to it for real.
SAP_API_BASE_URL=
# Service path appended to the base URL. Never used unless a base URL is set.
SAP_POSTING_PATH=
# Credentials are read from configuration only. They are never logged and never returned by any
# endpoint. Inject them from a secret store in every deployed environment.
SAP_API_USERNAME=
SAP_API_PASSWORD=
SAP_API_KEY=
# Included in the payload only when set. AGFZE routes between company codes (2000 UAE, 3010
# Singapore) and nothing specifies which transaction belongs to which, so the platform never
# picks one.
SAP_COMPANY_CODE=
# The Business Area postings are booked under. 1070 was named for AGFZE in discovery, so unlike
# the endpoint settings above this carries a real default rather than a placeholder.
SAP_BUSINESS_AREA=1070
SAP_TIMEOUT_SECONDS=30

# The document-management system. Same pattern and the same reasoning: a REST upload is what it
# exposes, its endpoint contract and metadata schema are not specified, so an unconfigured
# deployment compiles and stores the document pack for a person to file by hand.
DMS_API_BASE_URL=
DMS_UPLOAD_PATH=
DMS_API_KEY=
DMS_API_USERNAME=
DMS_API_PASSWORD=
DMS_REPOSITORY=
DMS_TIMEOUT_SECONDS=60

# The retry sweep. The first genuinely periodic job in this build with something real to drive:
# an attempt that failed transiently has a next attempt due at a calculable moment. It never
# picks up a job waiting on a person - there is nothing automated left to re-attempt on one.
INTEGRATION_SWEEP_ENABLED=true
INTEGRATION_SWEEP_INTERVAL_SECONDS=60
INTEGRATION_SWEEP_BATCH_SIZE=50
# Attempts before a job is marked failed and a technical-support-owned exception is opened.
INTEGRATION_MAX_ATTEMPTS=5
# 60s, then 120s, 240s, 480s..., capped at the maximum below.
INTEGRATION_RETRY_BASE_SECONDS=60
INTEGRATION_RETRY_MAX_SECONDS=3600

# --- Dashboard, analytics and reporting (Step 8) --------------------------------------------
# No new service and no new credential. Every value here has a working default; the block exists
# so a deployment can shift the schedule or the cache window without a code change.

# How long an aggregate is served from the in-process cache before it is recomputed from the
# governed tables. Short on purpose: a figure forty-five seconds old is still a true statement
# about the platform, and one ten minutes old is not. The API returns the age of what it served,
# so nothing is ever presented as live when it is not.
DASHBOARD_CACHE_TTL_SECONDS=45
DASHBOARD_CACHE_MAX_ENTRIES=512

# The scheduled reports. They ride the same periodic sweep the integration retries use rather
# than a scheduler of their own, so there is nothing extra to run. A generated report is stored
# in the platform and listed on /reports; it is NOT sent to anybody, because this platform has no
# outbound email or notification yet.
REPORT_SCHEDULE_ENABLED=true
# UTC, matching how the platform stores and reasons about every other timestamp. The daily report
# covers the day before its run time, which is the only version of it that is complete when it is
# produced.
REPORT_DAILY_HOUR_UTC=6
REPORT_DAILY_MINUTE_UTC=0
# The monthly management report, covering the month that has just ended.
REPORT_MONTHLY_DAY=1
REPORT_MONTHLY_HOUR_UTC=7
REPORT_MONTHLY_MINUTE_UTC=0
# Storage key prefix for the generated files. They are served only through the existing signed,
# expiring download route - there is no permanent public path to any report.
REPORT_STORAGE_PREFIX=reports
# Transactions one report will list individually. Above it the summary figures still cover every
# matching transaction and the report says how many it listed, rather than truncating silently.
REPORT_MAX_DETAIL_ROWS=500
# Whether the monthly report asks the model for its one-paragraph executive summary. Turning it
# off, or a failed call, costs the report that paragraph and nothing else: every figure in the
# body is computed by the platform and the section is honestly marked unavailable.
REPORT_AI_SUMMARY_ENABLED=true

# --- Notification delivery: email and push (Step 10) ---------------------------------------------
# Step 9 gave the platform one channel, in-app, and said plainly that a scheduled report was not
# sent to anybody. It is now. Three channels exist and they are independent of one another:
#
#   in-app  always, for every notification and every user. It is the platform's durable record,
#           not a preference somebody can switch off.
#   email   additionally, for a user whose `notification_channel` is `email` (Settings).
#   push    additionally, for a user whose BROWSER has an active subscription. It is not governed
#           by `notification_channel` at all - it is a browser permission, and the presence of a
#           `push_subscriptions` row is the entire gate.
#
# The whole block below is optional on a developer machine. Left unset, every notification is
# still created in-app and the two delivery attempts are skipped and logged as skipped, which is
# honest rather than silent.

# Where an email's call-to-action points. Assembled from this and nothing else - never from a
# request header - so a forged Host cannot rewrite the button in an email that cannot be recalled.
# Must be the deployment's own public origin in production; a localhost value is refused there.
APP_BASE_URL=http://localhost:3000

# The outbound relay. NEVER point local development at a real mail server: run a disposable
# catcher instead and read what would have been sent in its web UI. The compose stack ships
# MailHog for exactly this - `make mail` or `docker compose up -d mailhog`, then
# http://localhost:8025 - and the values below are already pointed at it. MailHog speaks plain
# SMTP on 1025 and presents no certificate, which is why STARTTLS is off here and must be on in
# every deployed environment.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM_ADDRESS=command-centre@agfze.local
SMTP_FROM_NAME=AGFZE Command Centre
SMTP_TIMEOUT_SECONDS=20
# Three attempts, then the failure is logged and audited and the platform moves on. A relay that
# has refused three times is down, and holding a business transaction open any longer would start
# costing it something. 2s, then 4s.
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=2

# Web Push (VAPID). Generate ONE pair per environment and keep it - regenerating invalidates every
# subscription every browser has ever taken, and every one of those users has to grant permission
# again. `make vapid-keys` prints a fresh pair as two lines to paste in here; it runs
# backend/scripts/generate_vapid_keys.py inside the backend image, which already carries py-vapid
# as a pywebpush dependency.
#
# The PUBLIC half is meant to be public: the Web Push standard hands it to the browser to bind a
# subscription with. It is served by GET /api/v1/notifications/vapid-public-key and is also baked
# into the frontend bundle as NEXT_PUBLIC_VAPID_PUBLIC_KEY (frontend/.env.example) - the two must
# be the same key.
VAPID_PUBLIC_KEY=
# The PRIVATE half signs every delivery. Backend and secret store only. It is never returned by
# any endpoint, never logged, and never reaches the frontend.
VAPID_PRIVATE_KEY=
# The `sub` claim on the signed JWT: a mailto: a push service can reach a human on.
VAPID_SUBJECT=mailto:command-centre@agfze.local
# How long a push service holds an undelivered message. A day - a decision that has waited longer
# than that is not news to surface when a phone wakes up.
PUSH_TTL_SECONDS=86400

# The master switch for both channels. Off, `notify` writes the in-app row exactly as Step 9 did
# and dispatches nothing.
NOTIFICATION_DELIVERY_ENABLED=true
