# Top-level dependencies only, deliberately unpinned. pip-tools resolves the full graph:
#
#   pip-compile --strip-extras requirements.in -o requirements.txt
#   pip-compile --strip-extras --generate-hashes requirements.in -o requirements.lock
#
# Both outputs are regenerated by `make lock`; never hand-edit them.

fastapi
uvicorn[standard]
sqlalchemy
asyncpg
alembic
pydantic
pydantic-settings
python-jose[cryptography]
slowapi
httpx
sentry-sdk
python-dotenv
python-multipart

# deterministic fuzzy matching for transaction matching (Step 3). Not an AI call, and
# deliberately independent of the Gemini services.
rapidfuzz

# the graph projection's driver. Only imported when GRAPH_SYNC_ENABLED is on and a store is
# configured, which is no deployment today - the projection is derived and entirely optional.
neo4j

# the object-store backend. Only imported when STORAGE_BACKEND names an object store, so a
# local-filesystem deployment carries the dependency without ever constructing a client.
google-cloud-storage

# document intake and extraction (Step 2)
google-genai
pymupdf
python-docx
pandas
openpyxl
python-magic

# outbound delivery channels (Step 10)
# pywebpush signs and delivers a VAPID Web Push payload; Jinja2 renders the HTML and plaintext
# parts of a notification email. Jinja2 arrives transitively through other packages already, and
# is declared here anyway because this platform now imports it directly.
pywebpush
jinja2

# dev / test
pytest
pytest-asyncio
aiosqlite
ruff
pip-tools
