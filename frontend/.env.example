# Base URL of the FastAPI backend, including the /api/v1 prefix. This value is inlined into
# the browser bundle, so it must be an address the user's machine can reach - not a
# docker-compose service name.
#
# It is also read twice at build time: the service-worker build script bakes its origin in as the
# one non-app origin the worker may cache, and the middleware puts it in the
# Content-Security-Policy's connect-src and img-src. `npm run verify:sw` fails the build if the
# worker was built against a different origin than the environment configures.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Base URL the Next.js server itself uses for server-rendered API calls. Inside docker-compose
# that is the backend service on the compose network; outside Docker leave it unset and it
# falls back to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# Keycloak confidential client that NextAuth runs the authorization-code flow against.
# Must match the client id in infra/keycloak/realm-agfze.json.
KEYCLOAK_CLIENT_ID=agfze-command-centre

# Secret for that client. The local realm import ships a throwaway development value;
# every deployed environment must inject this from a secret store, never from this file.
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret

# Browser-facing realm URL. Used for the authorize redirect and RP-initiated logout, and it
# must equal the `iss` claim Keycloak signs tokens with, otherwise the issuer check fails.
#
# Read by the middleware as well: it is one of the three origins the Content-Security-Policy
# allows the browser to connect to and submit a form to. Point this at the wrong host and
# sign-in is blocked by the policy rather than merely failing.
KEYCLOAK_ISSUER=http://localhost:8080/realms/agfze

# Server-side realm URL used for token exchange, refresh, userinfo and JWKS. Inside
# docker-compose the Next.js server reaches Keycloak as http://keycloak:8080 while the browser
# uses localhost. Outside Docker leave this equal to KEYCLOAK_ISSUER (it defaults to that).
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8080/realms/agfze

# Public origin of this application. NextAuth derives its callback URLs from it, so it has to
# match the redirect URIs registered on the Keycloak client exactly.
NEXTAUTH_URL=http://localhost:3000

# Signing/encryption key for the NextAuth session cookie. Generate a fresh one per
# environment and keep it out of version control:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The VAPID application server key, PUBLIC half only. The browser is handed this to bind a push
# subscription to the backend, so it is inlined into the client bundle at build time - which is
# exactly what the Web Push standard intends. It must be the same key as backend/.env's
# VAPID_PUBLIC_KEY; generate the pair once with `make vapid-keys`.
#
# The PRIVATE half signs deliveries and belongs to the backend alone. It must never appear in
# this file, in any NEXT_PUBLIC_* variable, or anywhere else the browser can read.
#
# Leave this empty and the push controls say plainly that this deployment has no key rather than
# offering a button that cannot work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
